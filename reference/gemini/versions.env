# reference/gemini — 数据源与版本（被 update.sh / scripts/*.sh source 读取）
# 覆盖方式：环境变量优先，例如 SDK_VERSION=3.6.1 ./update.sh

# 官方统一 GenAI SDK（不是已弃用的 @google/generative-ai / @google/generative-ai-old）
SDK_PACKAGE="${SDK_PACKAGE:-@google/genai}"
SDK_VERSION="${SDK_VERSION:-latest}"        # latest | 具体版本号 | next 等 dist-tag

# 文档站点：ai.google.dev/gemini-api/docs 已 301 到 aistudio.google.com/docs
DOCS_SITE="${DOCS_SITE:-https://aistudio.google.com}"
DOCS_INDEX_URL="${DOCS_INDEX_URL:-https://aistudio.google.com/llms.txt}"
DOCS_INDEX_FALLBACK_URL="${DOCS_INDEX_FALLBACK_URL:-https://ai.google.dev/llms.txt}"   # 实测 404，仅用于探测记录
DOCS_FULL_URL="${DOCS_FULL_URL:-https://aistudio.google.com/llms-full.txt}"            # 10.5MB 全文，不抓取
LEGACY_DOCS_URL="${LEGACY_DOCS_URL:-https://ai.google.dev/gemini-api/docs}"            # 301 -> aistudio
LEGACY_SITEMAP_URL="${LEGACY_SITEMAP_URL:-https://ai.google.dev/sitemap.xml}"          # devsite 旧站点，含 ?hl= 变体

# SDK 来源与 REST 主机
REGISTRY_URL="${REGISTRY_URL:-https://registry.npmjs.org/@google/genai}"
REST_BASE="${REST_BASE:-https://generativelanguage.googleapis.com}"

# 抓取礼貌参数
DOCS_SLEEP="${DOCS_SLEEP:-0.15}"            # 每个页面之间的间隔（秒）
DOCS_RETRIES="${DOCS_RETRIES:-3}"
DOCS_MAX_TIME="${DOCS_MAX_TIME:-60}"
