# Anthropic 参照快照的版本与来源配置。
# 由 update.sh / scripts/*.sh 以 `. versions.env` 方式读取（不是独立可执行脚本）。
#
# 覆盖方式（环境变量优先，文件里的默认值只在未设置时生效）：
#   SDK_VERSION=1.13.0 ./update.sh
#   DOCS_INDEX_URL=https://docs.claude.com/llms.txt ./update.sh --docs-only

# --- npm SDK ---
SDK_PACKAGE="${SDK_PACKAGE:-@anthropic-ai/sdk}"
# latest = 运行时用 `npm view <pkg> version` 解析成具体版本号
SDK_VERSION="${SDK_VERSION:-latest}"
NPM_REGISTRY_URL="${NPM_REGISTRY_URL:-https://registry.npmjs.org}"

# --- 官方文档 ---
# 规范主机：platform.claude.com（llms.txt 的 Root URL / Console 都指向它）。
# docs.claude.com/llms.txt 返回逐字节相同的内容（2026-11-24 校验 md5 一致），
# 保留为备用入口。
DOCS_INDEX_URL="${DOCS_INDEX_URL:-https://platform.claude.com/llms.txt}"
DOCS_BASE_URL="${DOCS_BASE_URL:-https://platform.claude.com/docs/en}"
# 备用/备用探测用（不参与抓取，仅记录在 docs/meta.json 里）
DOCS_INDEX_ALT_URL="${DOCS_INDEX_ALT_URL:-https://docs.claude.com/llms.txt}"

# 单页抓取参数（礼貌 + 重试）
CURL_MAX_TIME="${CURL_MAX_TIME:-60}"
CURL_RETRIES="${CURL_RETRIES:-3}"
CURL_RETRY_DELAY="${CURL_RETRY_DELAY:-2}"
# 每页之间休眠的秒数（BSD sleep 支持小数）
FETCH_SLEEP="${FETCH_SLEEP:-0.2}"