# OpenAI 快照配置。由 update.sh / scripts/*.sh source，可被同名环境变量覆盖。
#
# 注意：本文件以 `set -u` 安全的方式赋值，所有变量都给默认值。

# ---- npm SDK ----
SDK_PACKAGE="${SDK_PACKAGE:-openai}"
# latest = 每次刷新取 registry 上的最新版；也可固定版本：SDK_VERSION=7.63.0 ./update.sh
SDK_VERSION="${SDK_VERSION:-latest}"
NPM_REGISTRY="${NPM_REGISTRY:-https://registry.npmjs.org}"
SOURCE_REPO="${SOURCE_REPO:-https://github.com/openai/openai-node}"

# ---- 官方文档 ----
DOCS_SITE="${DOCS_SITE:-https://developers.openai.com}"
# 顶层路由索引（确认文档入口，写入 meta.json 便于追溯）
DOCS_INDEX="${DOCS_INDEX:-${DOCS_SITE}/api/llms.txt}"
# API 参考全量索引：其中列出的每个 .md 页面都抓取
DOCS_REFERENCE_INDEX="${DOCS_REFERENCE_INDEX:-${DOCS_SITE}/api/reference/llms.txt}"
# 指南索引：只抓 DOCS_GUIDE_INCLUDE 命中的 slug
DOCS_GUIDES_INDEX="${DOCS_GUIDES_INDEX:-${DOCS_SITE}/api/docs/llms.txt}"

# guides 白名单（按 /api/docs/ 之后、去掉 .md 的 slug 做 case 通配匹配）。
# 只保留「协议/接口行为」相关页面：请求响应格式、流式、工具调用、错误、模型、
# 文件/批处理/向量、语音转写、Realtime 传输。产品页（Agents API、ChatKit、Codex、
# Terraform、企业安全合规、定价、教程）一律不抓，见 README「收录范围」。
DOCS_GUIDE_INCLUDE="${DOCS_GUIDE_INCLUDE:-
concepts
quickstart
deprecations
changelog
libraries
libraries/*
models
models/*
guides/text
guides/completions
guides/streaming-responses
guides/structured-outputs
guides/function-calling
guides/async-tool-calling
guides/tools
guides/tools-*
guides/reasoning
guides/prompt-caching
guides/prompt-caching/*
guides/embeddings
guides/batch
guides/file-inputs
guides/image-generation
guides/images-vision
guides/moderation
guides/rate-limits
guides/token-counting
guides/conversation-state
guides/background
guides/webhooks
guides/error-codes
guides/compaction
guides/flex-processing
guides/predicted-outputs
guides/migrate-to-responses
guides/evals
guides/graders
guides/audio
guides/audio-chat-completions
guides/speech-to-text
guides/text-to-speech
guides/transcription
guides/realtime
guides/realtime-*
guides/voice-webrtc
guides/voice-websockets
guides/websocket-mode
guides/fine-tuning-best-practices
guides/supervised-fine-tuning
guides/vision-fine-tuning
}"

# ---- 抓取行为 ----
# 单页排除清单（URL 通配，默认空）。体积吃紧时可用它裁掉超大事件手册，例如：
#   DOCS_EXCLUDE="*/beta/subresources/responses/*"
DOCS_EXCLUDE="${DOCS_EXCLUDE:-}"
# 单个页面失败时：0 = 立即失败退出；1 = 继续，失败清单写进 docs/meta.json
DOCS_BEST_EFFORT="${DOCS_BEST_EFFORT:-0}"
DOCS_SLEEP="${DOCS_SLEEP:-0.2}"      # 每页之间的礼貌间隔（秒，可为小数）
DOCS_RETRIES="${DOCS_RETRIES:-3}"    # 单页最大尝试次数
DOCS_MAX_TIME="${DOCS_MAX_TIME:-60}" # curl --max-time
# 文档快照体积上限（字节），超过则中止并提示裁剪；当前范围约 8 MB
DOCS_MAX_BYTES="${DOCS_MAX_BYTES:-41943040}"

# ---- API 清单 ----
API_SOURCE_URL="${API_SOURCE_URL:-https://registry.npmjs.org/${SDK_PACKAGE}}"
